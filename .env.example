# OmniScribe API Configuration Keys
# Provide at least one API key below or configure directly in the Web UI Settings Modal.

# Google Gemini API Key (Recommended for high-accuracy diarization & native script preservation)
GEMINI_API_KEY=

# Groq Cloud Whisper API Key (Ultra-fast speech recognition)
GROQ_API_KEY=

# OpenAI API Key (Whisper & GPT diarization fallback)
OPENAI_API_KEY=

# Server Configuration
OMNISCRIBE_HOST=127.0.0.1
OMNISCRIBE_PORT=8000
